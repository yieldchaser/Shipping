{
  "stem": "advanced_shipping_2026_W31_ADVANCED-MARKET-REPORT-WEEK-31",
  "source_file": "advanced_shipping_2026_W31_ADVANCED-MARKET-REPORT-WEEK-31.pdf",
  "issue_date": "2026-07-31",
