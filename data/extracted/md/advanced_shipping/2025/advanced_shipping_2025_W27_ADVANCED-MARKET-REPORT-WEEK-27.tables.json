{
  "stem": "advanced_shipping_2025_W27_ADVANCED-MARKET-REPORT-WEEK-27",
  "source_file": "advanced_shipping_2025_W27_ADVANCED-MARKET-REPORT-WEEK-27.pdf",
  "issue_date": "2025-07-04",
