      "columns": [
        "Company",
        "Description",
        "Details"
      ],
      "row_count": 1,
      "rows": [
        {
          "Company": "Orsted",
          "Description": "Optimus Wind, a subsidiary of the Orsted Group, has awarded Subsea 7 a contract to install the entire inner array grid cable system on the Hornsea Two offshore wind farm. Offshore activity will take place in 2021 on the cable system",
