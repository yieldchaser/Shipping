  "freight_commentary": {
    "Dry Bulk Freight": "90,000 Bulk Carrier Spot Earnings (Gearless)\n\n50,000 Bulk Carrier Spot Earnings (Geared)",
    "Tanker Freight": "80,000 Product Tanker Spot Earnings"
