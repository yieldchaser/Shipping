  "quote_of_the_week": {
    "type": "Quote of the Week",
    "quote": "Beware of little expenses. A small leak will sink a great ship.",
    "author": "Benjamin Franklin (1706 - 1790) - American writer, scientist, statesman, diplomat, political philosopher and one of the Founding Fathers of the United States."
