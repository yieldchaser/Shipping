# Heavy data dumps
!reports/
!knowledge/
!knowledge/briefs/

# Derived-build speed caches (local-only; CI rebuilds from scratch)
knowledge/manifests/derived_cache.json
knowledge/derived/.wiki_score_cache.json
knowledge/derived/.wiki_meta_cache.json
# Full-fidelity derived artefacts: ~92 MB and ~45 MB, rewritten daily, ~90 MB of
# which is nested LLM output no consumer reads back. Published instead as
# signals_public.jsonl (~2 MB, every record and every scalar field the dashboard
# and daily brief use). Kept local; note that the daily workflow uses
# `git add -f`, which overrides this file, so these are also excluded there
# explicitly and guarded by a staged-size check.
knowledge/derived/signals.jsonl
knowledge/derived/section_index.jsonl

# Large model weights (HF checkpoints ~1-2GB, never commit)
*.safetensors
*.bin
*.pth
*.ckpt

# Heavy master JSON stores (>100MB exceeds GitHub hard limit; CSV store is committed)
bunker_master_historical.json
data/bunkers/bunker_master_historical.json

# Raw PDF archives
data/reports/*/pdfs/
data/raw/
# Extraction output: fully regenerable derived data (26k+ files, GBs). Keep local.
# Reproduce with scripts/extract/run_batch.py; do not commit.
data/extracted/
# Bulk vendor PDFs live under corpus/ but stay UNTRACKED (~3.9 GB would break
# pushes). Their per-file inventory + sha256 IS tracked, in
# corpus/_inventory_untracked.json, so loss is detectable and recoverable.
# Verify with: python scripts/verify/build_corpus_inventory.py --check
corpus/**/*.pdf
corpus/09-ppa/_root_pdfs/
corpus/06-drewry/ais/
# Temporary scraper / API citation caches
**/.cache_*
data/.cache_citations/
*.png
!assets/**/*.png
!reports/**/*.png
