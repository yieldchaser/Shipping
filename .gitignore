# Heavy data dumps
!reports/
!knowledge/
!knowledge/briefs/

# Derived-build speed caches (local-only; CI rebuilds from scratch)
knowledge/manifests/derived_cache.json
knowledge/derived/.wiki_score_cache.json
knowledge/derived/.wiki_meta_cache.json
# Full-fidelity derived artefacts: ~92 MB and ~45 MB, rewritten daily, ~90 MB of
# which is nested LLM output no consumer reads back. Published instead as
# signals_public.jsonl (~2 MB, every record and every scalar field the dashboard
# and daily brief use). Kept local; note that the daily workflow uses
# `git add -f`, which overrides this file, so these are also excluded there
# explicitly and guarded by a staged-size check.
knowledge/derived/signals.jsonl
knowledge/derived/section_index.jsonl

# Large model weights (HF checkpoints ~1-2GB, never commit)
*.safetensors
*.bin
*.pth
*.ckpt

# Heavy master JSON stores (>100MB exceeds GitHub hard limit; CSV store is committed)
bunker_master_historical.json
data/bunkers/bunker_master_historical.json

# Raw PDF archives
data/reports/*/pdfs/
data/raw/
# Extraction output: track canonical series CSVs/XLSX, register, LlamaParse run state,
# and extracted publisher Markdown + broker table sidecars online for CI/CD runners.
# Keep heavy raster caches, corpus mirrors, and duplicate SEC folders local.
data/extracted/*
!data/extracted/EXTRACTION_REGISTER.json
!data/extracted/series/
!data/extracted/llamaparse_*/
data/extracted/llamaparse_*/*
!data/extracted/llamaparse_*/_run_state.json
!data/extracted/md/
data/extracted/md/companies/
data/extracted/md/books/
data/extracted/md/images/
data/extracted/md/**/*.png
data/extracted/md/**/*.jpg
data/extracted/md/**/*.jpeg
data/extracted/md/**/*.gif
data/extracted/md/**/*.webp
data/extracted/md/**/*.pdf
data/extracted/md/**/*.charts.json
data/extracted/md/hellenic/**/*.tables.json
data/extracted/md/**/*.bak*
# Bulk historical vendor PDFs (>6 GB) stay untracked and cataloged in
# corpus/_inventory_untracked.json; newly scraped PDFs in CI are force-added.
corpus/**/*.pdf
corpus/09-ppa/_root_pdfs/
corpus/06-drewry/ais/
corpus/01-brokers/fearnleys-md/images/
